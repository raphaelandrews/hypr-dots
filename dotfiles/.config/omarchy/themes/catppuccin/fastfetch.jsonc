{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "source": "arch",
    "type": "small",
    "height": 12,
    "padding": {
      "top": 6,
      "left": 6,
      "right": 6
    },
    "color": {
      "1": "#89b4fa",
      "2": "#b4befe"
    }
  },
  "display": {
    "color": {
      "separator": "#cba6f7"
    },
    "separator": " ",
    "constants": [
      "   »»»»»»»»»»»»»»»»»»»»»»»»»»»»»»»»»»»»»»»»»»»»"
    ]
  },
  "modules": [
    "break",
    {
      "type": "title",
      "key": " PC",
      "keyColor": "#89b4fa"
    },
    {
      "type": "cpu",
      "key": " ",
      "showPeCoreCount": true,
      "keyColor": "#89b4fa"
    },
    {
      "type": "gpu",
      "key": " ",
      "detectionMethod": "pci",
      "keyColor": "#89b4fa"
    },
    {
      "type": "display",
      "key": "󱄄 ",
      "keyColor": "#89b4fa"
    },
    {
      "type": "disk",
      "key": "󰋊 ",
      "keyColor": "#89b4fa"
    },
    {
      "type": "memory",
      "key": " ",
      "keyColor": "#89b4fa"
    },
    {
      "type": "swap",
      "key": "󰓡 ",
      "keyColor": "#89b4fa"
    },
    "break",
    {
      "type": "command",
      "key": "󰣇 OS",
      "keyColor": "#b4befe",
      "text": "version=$(omarchy-version); echo \"Omarchy $version\""
    },
    {
      "type": "command",
      "key": "󰘬 ",
      "keyColor": "#b4befe",
      "text": "branch=$(omarchy-version-branch); echo \"$branch\""
    },
    {
      "type": "kernel",
      "key": " ",
      "keyColor": "#b4befe"
    },
    {
      "type": "wm",
      "key": " ",
      "keyColor": "#b4befe"
    },
    {
      "type": "de",
      "key": " DE ",
      "keyColor": "#b4befe"
    },
    {
      "type": "terminal",
      "key": " ",
      "keyColor": "#b4befe"
    },
    {
      "type": "packages",
      "key": "󰏖 ",
      "keyColor": "#b4befe"
    },
    {
      "type": "wmtheme",
      "key": "󰉼 ",
      "keyColor": "#b4befe"
    },
    {
      "type": "command",
      "key": "󰸌 ",
      "keyColor": "#b4befe",
      "text": "theme=$(omarchy-theme-current); echo -e \"$theme \\e[38;2;137;180;250m●\\e[38;2;180;190;254m●\\e[38;2;147;153;178m●\\e[38;2;203;166;247m●\\e[38;2;243;139;168m●\\e[38;2;250;179;135m●\""
    },
    {
      "type": "terminalfont",
      "key": " ",
      "keyColor": "#b4befe"
    },
    "break",
    {
      "type": "command",
      "key": "󱦟 OS Age ",
      "keyColor": "#fab387",
      "text": "birth_install=$(stat -c %W /); current=$(date +%s); time_progression=$((current - birth_install)); days_difference=$((time_progression / 86400)); echo $days_difference days"
    },
    {
      "type": "uptime",
      "key": "󱫐 Uptime ",
      "keyColor": "#fab387"
    },
    "break"
  ]
}
